[Unit]
Description=OpenClaw Local Redis Cache
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.openclaw/state/openclaw-operator/credentials/orchestrator.env
Environment=REDIS_STATE_DIR=%h/.openclaw/state/openclaw-operator/coordination/redis
ExecStartPre=-/usr/bin/docker rm -f openclaw-host-redis
ExecStart=%h/.openclaw/workspace/scripts/run-openclaw-redis-container.sh
ExecStop=/usr/bin/docker stop openclaw-host-redis
Restart=always
RestartSec=5
TimeoutStartSec=0
UMask=0077

[Install]
WantedBy=default.target
